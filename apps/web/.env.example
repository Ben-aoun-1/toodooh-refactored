# apps/web — environment variables
#
# Copy this file to `.env` (or `.env.local`) and fill in real values for local dev.
# NEVER commit a real `.env*` file.
#
# IMPORTANT: every `VITE_`-prefixed variable is inlined into the client bundle at build
# time. It is shipped to every browser and is therefore PUBLIC — never put a secret here.
# Supabase's "anon" key is designed to be public (it's gated by Row Level Security), and
# the project URL is public too — so both are fine to expose. Anything truly secret must
# live server-side only, which does not exist in this repo yet.

# Supabase project URL — referenced in src/lib/supabase.ts
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous (publishable) API key — referenced in src/lib/supabase.ts
VITE_SUPABASE_ANON_KEY=your-anon-key
