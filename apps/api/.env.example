DATABASE_URL=postgresql://toodooh:toodooh@localhost:5432/toodooh_dev
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-openssl-rand-hex-32-value-min-32-chars
# AES-256-GCM key for screenhost WiFi passwords (recoverable at-rest encryption).
# Base64 of exactly 32 bytes. Generate with: openssl rand -base64 32
# The real key is provisioned on the VPS at deploy time — do NOT commit a real key.
WIFI_ENC_KEY=replace-with-openssl-rand-base64-32-value-decoding-to-32-bytes
# better-auth base URL — used to build verification links.
# Local dev: http://localhost:4000; production: https://api.too-dooh.com (Phase 1g).
BETTER_AUTH_URL=http://localhost:4000
# OVH SMTP — verification email send. HOST/PORT/SECURE have defaults.
SMTP_HOST=smtp.mail.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@too-dooh.com
SMTP_PASSWORD=<from-password-manager>
SMTP_FROM=no-reply@too-dooh.com
# MinIO / S3-compatible object storage (Commit 2). Dev creds = the docker-compose
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD. BUCKET/REGION have defaults.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=toodooh-documents
STORAGE_REGION=us-east-1
