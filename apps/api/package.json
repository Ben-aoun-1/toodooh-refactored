{
  "name": "@toodooh/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "promote": "tsx --env-file-if-exists=.env scripts/promote-to-admin.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fastify": "5.8.5",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "20.19.41",
    "drizzle-kit": "0.31.10",
    "tsx": "4.22.3",
    "typescript": "5.7.2",
    "vitest": "4.1.6"
  }
}
